{
  "name": "@torsor/server",
  "version": "0.1.0",
  "description": "Local production host for the Torsor kernel and agent runtime",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prebuild": "npm run build --workspace @torsor/kernel && npm run build --workspace @torsor/agent-runtime",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@torsor/agent-runtime": "0.1.0",
    "@torsor/kernel": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
