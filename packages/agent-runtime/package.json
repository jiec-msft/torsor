{
  "name": "@torsor/agent-runtime",
  "version": "0.1.0",
  "description": "Provider-neutral durable Agent runtime for Torsor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm --prefix ../kernel run build && npm --prefix ../operational-logging run build && npm run build",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@torsor/kernel": "0.1.0",
    "@torsor/operational-logging": "0.1.0",
    "koffi": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
